              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'claude-haiku-4-5-20251001', max_tokens: 500, messages: [{ role: 'user', content: 'You are a sales call analyst for Nexa Consultancy, a loan brokerage in BC, Canada. Summarize this sales call in 3-4 bullet points. Include: (1) What the lead wants, (2) Any objections or concerns, (3) Next steps agreed, (4) Lead temperature: Hot/Warm/Cold with reason. Call transcript: ' + ($json.body?.call_transcript || $json.call_transcript || '') }] } }}",
        "options": {}
      },
      "id": "anthropic-summarize-call",
      "name": "Anthropic - Summarize Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json || {}; const webhook = $('Webhook - AI Call Summary').item.json || {}; const body = webhook.body || webhook; const content = response.body?.content || response.data?.content || response.content || []; const summary = Array.isArray(content) ? content.map(item => item.text || '').filter(Boolean).join('\\n').trim() : String(content || response.text || response.body?.text || '').trim(); return [{ json: { contactId: body.contact_id, summary } }];"
      },
      "id": "prepare-call-summary-note",
      "name": "Prepare Call Summary Note",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://services.leadconnectorhq.com/contacts/' + $json.contactId + '/notes' }}",
