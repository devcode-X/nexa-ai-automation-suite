    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.candidate_email }}",
        "subject": "={{ 'Reminder: Your Interview Tomorrow - ' + $json.job_title }}",
        "emailType": "html",
        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:32px 24px;\"><p style=\"font-size:16px;color:#333;\">Hi <strong>' + $json.candidate_name + '</strong>,</p><p style=\"font-size:15px;color:#444;line-height:1.7;\">This is a reminder that your interview for the <strong>' + $json.job_title + '</strong> position is scheduled for <strong>tomorrow</strong>.</p><div style=\"background:#f5f7ff;border-left:4px solid #1a2744;padding:16px 20px;border-radius:4px;margin:20px 0;\"><p style=\"margin:0;color:#1a2744;\"><strong>' + DateTime.fromISO($json.slot_datetime).setZone('America/Vancouver').toFormat('cccc, LLLL d, yyyy') + '</strong><br><strong>' + DateTime.fromISO($json.slot_datetime).setZone('America/Vancouver').toFormat('h:mm a') + ' Pacific Time</strong><br>12899 80 Ave #203, Surrey, BC V3W 0E6</p></div><p style=\"font-size:15px;color:#444;\">Questions? Call <strong>778-582-4000</strong> or reply to this email. See you tomorrow!</p><br><p style=\"color:#666;font-size:14px;\">Best regards,<br><strong>Karan Verma</strong><br>Nexa Marketing Inc.</p></div>' }}",
        "options": {
          "senderName": "Karan Verma",
          "appendAttribution": false
        }
      },
      "id": "gmail-send-day-reminder",
      "name": "Gmail - Send Day Reminder",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1040,
        40
      ]
    },
