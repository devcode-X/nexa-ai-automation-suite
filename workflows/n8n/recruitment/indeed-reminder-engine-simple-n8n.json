              "name": "reminder_1hr_sent",
              "type": "boolean"
            }
          ]
        },
        "options": {
          "createIfNotExists": true
        }
      },
      "id": "data-table-ensure-interview-slots",
      "name": "Data Table - Ensure Interview Slots",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "Indeed Interview Slots",
          "mode": "name",
          "cachedResultName": "Indeed Interview Slots"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "is_booked",
              "condition": "eq",
              "keyValue": true
            },
            {
              "keyName": "reminder_day_sent",
              "condition": "neq",
              "keyValue": true
            },
            {
              "keyName": "slot_datetime",
              "condition": "gt",
              "keyValue": "={{ $now.plus({ minutes: 1380 }).toISO() }}"
            },
            {
              "keyName": "slot_datetime",
              "condition": "lt",
              "keyValue": "={{ $now.plus({ minutes: 1440 }).toISO() }}"
            }
          ]
        },
        "returnAll": true,
        "limit": 10
      },
      "id": "data-table-find-day-reminders",
