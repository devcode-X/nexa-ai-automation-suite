    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "sk-ant-REDACTED_REPLACE_WITH_YOUR_KEY"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ {\n  model: 'claude-haiku-4-5-20251001',\n  max_tokens: 256,\n  messages: [\n    {\n      role: 'user',\n      content: 'Analyze this email and classify it. Email subject: ' + ($('Gmail - New Candidate Reply').item.json.subject || '') + '. Email body: ' + ($('Gmail - New Candidate Reply').item.json.text?.plain || $('Gmail - New Candidate Reply').item.json.textPlain || $('Gmail - New Candidate Reply').item.json.text || $('Gmail - New Candidate Reply').item.json.snippet || '') + '. Return ONLY valid JSON with no markdown, using these exact keys: type (string, one of: reschedule_request, rsvp_confirm, calendar_decline, other), sender_email (string, the actual candidate email address extracted from the email from header or body), preferred_time_mentioned (string), reason (string). Rules: reschedule_request=candidate wants to change their interview time; rsvp_confirm=email subject starts with Accepted: (Google Calendar acceptance) OR candidate explicitly confirms attendance (yes, confirmed, I will attend, looking forward, see you, I will come, I will be there); calendar_decline=email subject starts with Declined: (Google Calendar decline) OR candidate says they cannot attend or want to cancel; other=anything else.'\n    }\n  ]\n} }}",
        "options": {}
      },
      "id": "anthropic-classify-reply",
      "name": "Anthropic - Classify Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const gmail = $items('Gmail - New Candidate Reply')[0]?.json || {};\nconst response = $input.first().json || {};\nconst rawText = response.content?.[0]?.text || response.data?.content?.[0]?.text || response.data?.content?.[1]?.text || response.body?.content?.[0]?.text || '';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(String(rawText).replace(/```json|```/g, '').trim());\n} catch (error) {\n  parsed = { type: 'other', sender_email: '', preferred_time_mentioned: '', reason: 'Could not parse classifier response' };\n}\nconst fromValue = Array.isArray(gmail.from) ? (gmail.from[0]?.email || gmail.from[1]?.email || '') : (gmail.from?.email || gmail.from || '');\nconst bodyText = gmail.text?.plain || gmail.textPlain || gmail.text || gmail.snippet || '';\nconst emailMatch = String(fromValue + ' ' + bodyText).match(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/);\nreturn [{\n  json: {\n    type: parsed.type || 'other',\n    sender_email: parsed.sender_email || (emailMatch ? emailMatch[0] : ''),\n    preferred_time_mentioned: parsed.preferred_time_mentioned || '',\n    reason: parsed.reason || '',\n    subject: gmail.subject || '',\n    email_text: bodyText,\n    from_email: fromValue\n  }\n}];"
      },
      "id": "code-parse-classification",
      "name": "Code - Parse Classification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        320
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "reschedule_request",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reschedule_request"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "rsvp_confirm",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "rsvp_confirm"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.type }}",
                    "rightValue": "calendar_decline",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "calendar_decline"
            }
          ]
        },
        "options": {}
      },
