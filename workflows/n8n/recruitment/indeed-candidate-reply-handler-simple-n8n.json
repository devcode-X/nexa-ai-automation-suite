      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\nconst list = rows\n  .filter(row => row.slot_datetime)\n  .slice(0, 5)\n  .map(row => {\n    const start = DateTime.fromISO(row.slot_datetime).setZone('America/Vancouver');\n    return `<li style=\"margin:6px 0;\"><strong>${start.toFormat('cccc, LLLL d')}</strong> at ${start.toFormat('h:mm a')} Pacific time</li>`;\n  })\n  .join('');\nconst classification = $items('Code - Parse Classification')[0]?.json || {};\nconst subject = classification.subject || '';\nconst nameMatch = subject.match(/^Declined: Interview - (.+?) \\| .+$/);\nreturn [{\n  json: {\n    slots_html: list,\n    candidate_email: classification.sender_email || classification.from_email,\n    candidate_name: nameMatch ? nameMatch[1].trim() : 'there'\n  }\n}];"
      },
