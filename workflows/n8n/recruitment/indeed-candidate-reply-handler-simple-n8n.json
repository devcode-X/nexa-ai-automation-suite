        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:32px 24px;\"><p style=\"font-size:16px;color:#333;\">Hi <strong>' + $json.candidate_name + '</strong>,</p><p style=\"font-size:15px;color:#444;line-height:1.7;\">We noticed you were not able to make the scheduled interview - completely understandable, life happens!</p><p style=\"font-size:15px;color:#444;line-height:1.7;\">We would genuinely love to meet you. Here are our next <strong>available slots</strong>:</p><div style=\"background:#f5f7ff;border-left:4px solid #1a2744;padding:16px 20px;border-radius:4px;margin:20px 0;\"><p style=\"margin:0 0 10px;font-weight:bold;color:#1a2744;\">Available Interview Times:</p><ul style=\"margin:0;padding-left:20px;color:#333;\">' + $json.slots_html + '</ul></div><p style=\"font-size:15px;color:#444;line-height:1.7;\">Our interview hours are <strong>Monday to Friday, 1:00 PM - 2:30 PM Pacific time</strong>.</p><p style=\"font-size:15px;color:#444;line-height:1.7;\">Just <strong>reply to this email</strong> with the time that works best and we will book you right away!</p><br><p style=\"color:#666;font-size:14px;\">Warm regards,<br><strong>Karan Verma</strong><br>Nexa Marketing Inc.</p></div>' }}",
