    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.candidate_email }}",
        "subject": "Quick Reminder - Your Interview at Nexa Marketing Inc.",
        "emailType": "html",
        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:32px 24px;\"><p style=\"font-size:16px;color:#333;\">Hi <strong>' + $json.candidate_name + '</strong>,</p><p style=\"font-size:15px;color:#444;line-height:1.7;\">Just a friendly reminder that you have an upcoming interview for the <strong>' + $json.job_title + '</strong> position at <strong>Nexa Marketing Inc.</strong>!</p><div style=\"background:#f5f7ff;border-left:4px solid #1a2744;padding:16px 20px;border-radius:4px;margin:20px 0;\"><p style=\"margin:0;color:#1a2744;\"><strong>Date:</strong> ' + DateTime.fromISO($json.slot_datetime).setZone('America/Vancouver').toFormat('cccc, LLLL d, yyyy') + '<br><strong>Time:</strong> ' + DateTime.fromISO($json.slot_datetime).setZone('America/Vancouver').toFormat('h:mm a') + ' - ' + DateTime.fromISO($json.slot_datetime).plus({ minutes: 30 }).setZone('America/Vancouver').toFormat('h:mm a') + ' Pacific time<br><strong>Location:</strong> 12899 80 Ave #203, Surrey, BC V3W 0E6</p></div><p style=\"font-size:15px;color:#444;line-height:1.7;\">Please <strong>reply to this email</strong> to let us know you will be there. Cannot make this time? Just reply and we will find something better - available <strong>Mon-Fri, 1:00-2:30 PM Pacific time</strong>.</p><p style=\"font-size:15px;color:#444;\">Looking forward to meeting you soon!</p><br><p style=\"color:#666;font-size:14px;\">Warm regards,<br><strong>Karan Verma</strong><br>Nexa Marketing Inc.<br>12899 80 Ave #203, Surrey, BC<br>karan9463verma@gmail.com</p></div>' }}",
        "options": {
          "senderName": "Karan Verma",
          "appendAttribution": false
        }
      },
