        "message": "={{ '<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;padding:32px 24px;\"><p style=\"font-size:16px;color:#333;\">Hi <strong>' + $json.candidate_name + '</strong>,</p><p style=\"font-size:15px;color:#444;line-height:1.7;\">Just checking in - we sent you an interview invitation a few days ago and wanted to make sure it did not get lost in your inbox!</p><p style=\"font-size:15px;color:#444;line-height:1.7;\">We are genuinely excited about your application and have a spot reserved for you:</p><div style=\"background:#f5f7ff;border-left:4px solid #1a2744;padding:16px 20px;border-radius:4px;margin:20px 0;\"><p style=\"margin:0;color:#1a2744;\"><strong>' + DateTime.fromISO($json.slot_datetime).setZone('America/Vancouver').toFormat('cccc, LLLL d, yyyy') + '</strong><br><strong>' + DateTime.fromISO($json.slot_datetime).setZone('America/Vancouver').toFormat('h:mm a') + ' - ' + DateTime.fromISO($json.slot_datetime).plus({ minutes: 30 }).setZone('America/Vancouver').toFormat('h:mm a') + ' Pacific time</strong><br>12899 80 Ave #203, Surrey, BC V3W 0E6</p></div><p style=\"font-size:15px;color:#444;line-height:1.7;\">Just <strong>reply to this email</strong> to confirm you will be there. If this time does not work, just reply - available <strong>Mon-Fri, 1:00-2:30 PM Pacific time</strong>.</p><p style=\"font-size:15px;color:#444;\">We would love to meet you!</p><br><p style=\"color:#666;font-size:14px;\">Warm regards,<br><strong>Karan Verma</strong><br>Nexa Marketing Inc.</p></div>' }}",
