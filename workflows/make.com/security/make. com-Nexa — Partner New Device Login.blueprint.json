{
    "name": "Nexa — Partner New Device Login",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 2192805,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                }
            }
        },
        {
            "id": 2,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/contacts/upsert",
                "data": "{\"locationId\":\"NRcuWE1OyAEdoOmZqjpu\",\"email\":\"{{1.email}}\",\"firstName\":\"{{1.name}}\",\"tags\":[\"partner-login-event\"]}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "name": "Accept",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": true,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
        {
            "id": 3,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/conversations/messages",
                "data": "{\"type\":\"Email\",\"emailTo\":\"{{1.email}}\",\"subject\":\"[Partner] New device sign-in code — {{1.code}}\",\"html\":\"<p>Hi {{1.name}},</p><p>A sign-in was requested on a new device for your Nexa Partner Portal.</p><p><strong>Your code: {{1.code}}</strong></p><p>Device: {{1.userAgent}}<br>Time: {{1.ts}}</p><p>If this wasn't you, reply to this email immediately.</p>\"}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": true,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                }
            }
        },
        {
            "id": 4,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/conversations/messages",
                "data": "{\"type\":\"SMS\",\"contactId\":\"{{2.data.contact.id}}\",\"message\":\"Your Nexa code: {{1.code}}. Do not share.\"}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": true,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0
                }
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
