{
    "name": "Nexa — Partner Password Changed",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 2192810,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                }
            }
        },
        {
            "id": 2,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/contacts/upsert",
                "data": "{\"locationId\":\"NRcuWE1OyAEdoOmZqjpu\",\"email\":\"{{1.email}}\",\"firstName\":\"{{1.name}}\",\"tags\":[\"partner-password-changed\"]}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    },
                    {
                        "name": "Accept",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": true,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
        {
            "id": 3,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/conversations/messages",
                "data": "{\"type\":\"Email\",\"contactId\":\"{{2.data.contact.id}}\",\"subject\":\"[Partner] Your portal password was changed\",\"html\":\"<p>Hi {{1.name}},</p><p>Your Nexa Partner Portal password was changed.</p><p><strong>Device:</strong> {{1.userAgent}}<br><strong>Time:</strong> {{1.ts}}<br><strong>Action:</strong> {{1.action}}</p><p><strong>If this wasn't you, reply immediately so we can lock the account.</strong></p><p>— Karan Verma, Nexa Consultancy</p>\"}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": true,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                }
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com",
        "notes": []
    }
}