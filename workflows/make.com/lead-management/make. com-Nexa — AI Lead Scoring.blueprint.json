{
    "name": "Nexa — AI Lead Scoring",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 2139551,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                }
            }
        },
        {
            "id": 2,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://api.anthropic.com/v1/messages",
                "data": "{\"model\":\"claude-haiku-4-5-20251001\",\"max_tokens\":200,\"messages\":[{\"role\":\"user\",\"content\":\"Score this loan lead 0-100. Return ONLY JSON: {\\\"score\\\":NUMBER,\\\"reason\\\":\\\"text\\\"}. Lead: Name={{1.body.name}}, Loan={{1.body.loan_type}}, Amount={{1.body.loan_amount}}, Status={{1.body.status_in_canada}}, Source={{1.body.lead_source}}\"}]}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "x-api-key",
                        "value": "sk-ant-REDACTED_REPLACE_WITH_YOUR_KEY"
                    },
                    {
                        "name": "anthropic-version",
                        "value": "2023-06-01"
                    },
                    {
                        "name": "content-type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
        {
            "id": 3,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/contacts/{{1.body.contact_id}}",
                "data": "{\"customFields\":[{\"key\":\"ai_lead_score\",\"field_value\":\"{{2.data.content[].text}}\"}]}",
                "gzip": true,
                "method": "put",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                }
            }
        },
        {
            "id": 4,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
            },
            "filter": {
                "name": "Score > 80",
                "conditions": [
                    [
                        {
                            "a": "{{2.data.content[].text}}",
                            "b": "\"score\":([89][0-9]|100)",
                            "o": "text:match"
                        }
                    ]
                ]
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/contacts/{{1.body.contact_id}}/tags",
                "data": "{\"tags\":[\"high-value-lead\",\"ai-scored\"]}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0
                }
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com",
        "notes": []
    }
}