{
    "name": "Nexa — Lead Capture & Follow-up",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 2140292,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                }
            }
        },
        {
            "id": 2,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
            },
            "filter": {
                "name": "Only process form submissions",
                "conditions": [
                    [
                        {
                            "a": "{{1.email}}",
                            "b": "",
                            "o": "text:notequal"
                        }
                    ]
                ]
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/contacts/",
                "data": "{\"firstName\":\"{{1.first_name}}\",\"lastName\":\"{{1.last_name}}\",\"email\":\"{{1.email}}\",\"locationId\":\"NRcuWE1OyAEdoOmZqjpu\"}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
        {
            "id": 3,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/opportunities/",
                "data": "{\"pipelineId\":\"EOW1CWVHMkNmlbr4sI6O\",\"pipelineStageId\":\"83ae729a-6b14-426d-928e-998de5b3b256\",\"locationId\":\"NRcuWE1OyAEdoOmZqjpu\",\"contactId\":\"{{2.data.contact.id}}\",\"name\":\"{{1.first_name}} {{1.last_name}} — New Lead\",\"status\":\"open\",\"source\":\"{{1.lead_source}}\"}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                }
            }
        },
        {
            "id": 4,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://services.leadconnectorhq.com/conversations/messages",
                "data": "{\"type\":\"Email\",\"contactId\":\"{{2.data.contact.id}}\",\"subject\":\"Welcome to Nexa, {{1.first_name}}!\",\"html\":\"<p>Hi {{1.first_name}},</p><p>Thank you for reaching out to Nexa! We have received your inquiry about <strong>{{1.loan_type}}</strong> and one of our consultants will be in touch within 24 hours.</p><p>In the meantime, feel free to reply to this email with any questions.</p><p>Best regards,<br><strong>The Nexa Team</strong></p>\"}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer YOUR_API_TOKEN_HERE"
                    },
                    {
                        "name": "Version",
                        "value": "2021-07-28"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0
                }
            }
        },
        {
            "id": 7,
            "module": "datastore:AddRecord",
            "version": 1,
            "parameters": {
                "datastore": 90626
            },
            "mapper": {
                "key": "{{2.data.contact.id}}",
                "data": {
                    "email": "{{1.email}}",
                    "phone": "{{1.phone}}",
                    "day1Sent": false,
                    "day3Sent": false,
                    "loanType": "{{1.loan_type}}",
                    "contactId": "{{2.data.contact.id}}",
                    "createdAt": "{{formatDate(now; \"X\")}}",
                    "firstName": "{{1.first_name}}"
                },
                "overwrite": true
            },
            "metadata": {
                "designer": {
                    "x": 1200,
                    "y": 0
                }
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 10,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com",
        "notes": []
    }
}